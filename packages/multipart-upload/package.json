{
  "name": "@mr_innovations/multipart-upload",
  "version": "0.1.0",
  "description": "Resumable multipart file uploads for Next.js — server route handlers, browser client and React hook. No database: the filesystem is the state.",
  "keywords": [
    "upload",
    "multipart",
    "resumable",
    "chunked",
    "large-file",
    "nextjs",
    "next",
    "react",
    "app-router"
  ],
  "license": "MIT",
  "author": "mujeeb-enfin",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.9.0"
  },
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "npm run build && publint && attw --pack . --profile esm-only",
    "prepublishOnly": "npm run check:package && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "publint": "0.3.25",
    "react": "19.3.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
