# Copy to .env.local and adjust. Every value is optional. The values below are
# the package defaults, except MULTIPART_UPLOAD_ALLOWED_TYPES, which is filled
# in with the demo's list (the default is empty: every type allowed).
#
# NOTE: this demo sets maxFileBytes, partBytes and allowedTypes IN CODE
# (app/upload-settings.ts, passed in app/api/uploads/[[...path]]/route.ts).
# A value set in code wins, so for those three the variables below are only a
# fallback: remove a setting from the route to have its variable used instead.

# Largest file accepted, in bytes. 524288000 = 500 MiB.
MULTIPART_UPLOAD_MAX_FILE_BYTES=524288000

# Bytes per part, between 1048576 (1 MiB) and 8388608 (8 MiB).
# Your reverse proxy must accept bodies of this size plus a little headroom
# (nginx: client_max_body_size 10m).
MULTIPART_UPLOAD_PART_BYTES=2097152

# Where parts and finished files are stored. Must be a persistent, writable disk.
MULTIPART_UPLOAD_DIR=./uploads

# Unfinished uploads untouched for this many hours are removed.
MULTIPART_UPLOAD_PART_TTL_HOURS=48

# Set a distinct value per server if you run more than one instance.
MULTIPART_UPLOAD_INSTANCE_ID=

# File types accepted, comma-separated, in HTML `accept` syntax: a MIME type
# (application/pdf), a wildcard (image/*) or an extension (.zip). Leave empty to
# allow every type. Checked by declared type when the upload starts AND by the
# file's real content before it is stored (a renamed .exe is refused).
#
# Filled in with the same list the demo sets in code: JPEG, PNG, GIF, WebP,
# any video, any audio, PDF and .zip. Other examples:
#   image/*                                          any image
#   image/jpeg,image/png,image/webp,application/pdf  exact types
#   .zip,.csv,text/plain                             extensions and types
#   video/*,audio/*                                  any video or audio
MULTIPART_UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,video/*,audio/*,application/pdf,.zip
